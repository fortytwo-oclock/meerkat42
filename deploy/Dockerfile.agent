# syntax=docker/dockerfile:1
# Multi-stage, multi-platform build for the ultra-lightweight Edge Agent.
FROM --platform=$BUILDPLATFORM golang:1.21-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG TARGETVARIANT

WORKDIR /build
COPY go.mod ./
# If go.sum exists, copy it
COPY . .

RUN case "$TARGETVARIANT" in v*) export GOARM="${TARGETVARIANT#v}" ;; esac; \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -trimpath -ldflags="-s -w" -o agent ./cmd/agent

FROM alpine:3.19

# Optional: smartmontools for S.M.A.R.T. disk forensics
RUN apk add --no-cache ca-certificates smartmontools

WORKDIR /app
COPY --from=builder /build/agent /app/agent

ENV HUB_URL="ws://hub:8080/api/v1/agent/stream"
ENV PUSH_INTERVAL_SEC="10"
ENV IMAGE_UPDATE_CHECK_ENABLED="false"

ENTRYPOINT ["/app/agent"]
