# For a trusted LAN quickstart, ws://HUB_IP:8080 is acceptable. Use wss://
# through a TLS reverse proxy for internet or untrusted-network access.
HUB_URL=wss://meerkat.example.com/api/v1/agent/stream
NODE_ID=replace_with_a_stable_unique_node_id
# Docker's internal hostname is usually an ephemeral container ID. Set the
# actual host label operators should see in the dashboard.
HOSTNAME_OVERRIDE=replace_with_the_servers_hostname
# Start with AGENT_BOOTSTRAP_TOKEN from deploy/self-host.env. For additional
# nodes, prefer a group-bound cpa_... enrollment token created in Settings.
AUTH_TOKEN=replace_with_agent_credential
CLIENT_GROUP=default
PUSH_INTERVAL_SEC=10

# Optional features remain agent-local. Uncomment only what this host needs.
# IMAGE_UPDATE_CHECK_ENABLED=true
# VAULT_KEY=replace_with_base64_32_byte_key
# VAULT_PATHS=/opt/stacks:/srv/compose
