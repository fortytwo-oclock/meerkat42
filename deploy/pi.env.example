# Raspberry Pi headend: Raspberry Pi 4/5 running a 64-bit OS is recommended.
# Generate both tokens independently, for example: openssl rand -hex 32
ADMIN_TOKEN=replace_with_a_long_random_owner_token
AGENT_BOOTSTRAP_TOKEN=replace_with_a_different_long_random_agent_token

# Keep localhost when a reverse proxy runs on this Pi. Use 0.0.0.0 only on a
# trusted LAN or when host firewall rules restrict access.
BIND_ADDRESS=127.0.0.1
HUB_PORT=8080
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:3000

# The public key used to verify offline licenses. Community deployments may use
# the development key until they introduce their own signed enterprise licenses.
ED25519_PUBLIC_KEY=31iGBIN15cAlkXmYXYLwZTXJYR9Yngjzf187Bf+s+xA=
