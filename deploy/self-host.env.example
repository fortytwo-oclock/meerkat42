# Copy this file to deploy/self-host.env and replace both token placeholders,
# or generate a ready-to-use file with: python scripts/bootstrap_self_host.py
ADMIN_TOKEN=replace_with_a_long_random_owner_token
AGENT_BOOTSTRAP_TOKEN=replace_with_a_different_long_random_agent_token

# Loopback is safest when using the dashboard locally or through a reverse proxy.
BIND_ADDRESS=127.0.0.1
HUB_PORT=8080
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Public verification key for Community and issued offline licenses.
ED25519_PUBLIC_KEY=31iGBIN15cAlkXmYXYLwZTXJYR9Yngjzf187Bf+s+xA=
