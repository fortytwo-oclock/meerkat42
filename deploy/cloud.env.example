# Public DNS name pointed at this host.
DOMAIN=monitor.example.com
LOG_LEVEL=info
HUB_REPLICAS=2
CONTROL_PLANE_VERSION=local

# Use long, independently generated secrets. URL-encode POSTGRES_PASSWORD in
# DATABASE_URL if it contains reserved URL characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://control_plane:replace-with-a-long-random-password@postgres:5432/control_plane
ADMIN_TOKEN=replace-with-a-long-random-owner-token
# Optional legacy token for the default tenant. Prefer group-bound agent tokens
# created in Settings or POST /api/v1/agent-tokens.
AGENT_BOOTSTRAP_TOKEN=

# Destructive remote-action policies wait for a different owner to approve.
REMOTE_COMMAND_TWO_PERSON_APPROVAL=true

# Break-glass diagnostics are disabled by default. If enabled, provision this
# base32 secret into an authenticator app and your recovery secret manager.
EMERGENCY_CONSOLE_ENABLED=false
EMERGENCY_TOTP_SECRET=

# Matching raw Ed25519 keys, standard base64. The private key stays here only.
ED25519_PUBLIC_KEY=replace-with-public-key
LICENSE_SIGNING_PRIVATE_KEY=replace-with-private-key

STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRODUCT_PLANS_JSON={"prod_replace_me":{"price_id":"price_replace_me","tier":"enterprise","max_nodes":100,"features":["vault_backup","white_label"]}}

# Optional durable license delivery. License issuance succeeds even when SMTP is
# down; the Hub retries with exponential backoff.
BILLING_EMAIL_ENABLED=false
BILLING_EMAIL_FROM=licenses@example.com
BILLING_EMAIL_REPLY_TO=support@example.com
BILLING_SMTP_HOST=smtp.example.com
BILLING_SMTP_PORT=587
BILLING_SMTP_USERNAME=replace-me
BILLING_SMTP_PASSWORD=replace-me
BILLING_SMTP_SSL=false
BILLING_SMTP_STARTTLS=true
